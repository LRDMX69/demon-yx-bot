{
  "name": "demon-yx-bot",
  "version": "6.1.7-demonyx.1",
  "description": "Dēmonyx — a hardened multi-session WhatsApp bot built on Baileys, preserving the original plugin, moderation, media, and webhook API features while adding a local-first MoE router and 11,000+ specialist commands.",
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "whatsapp-api",
    "whatsapp-automation",
    "baileys",
    "demon yx",
    "levanter",
    "wa-bot",
    "chatbot",
    "bot",
    "multi-session",
    "webhook",
    "message-api",
    "group-management",
    "anti-link",
    "sticker",
    "media-downloader",
    "nodejs",
    "plugin",
    "specialist-agent",
    "mixture-of-experts"
  ],
  "main": "index.js",
  "scripts": {
    "start": "pm2 start . --attach --name demonyx",
    "docker": "pm2-runtime start . --name demonyx",
    "stop": "pm2 stop demonyx",
    "test": "node test/demonyx.test.js",
    "test:syntax": "find . -type f -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "train:moe": "node scripts/train-local-moe.js",
    "evaluate:moe": "node scripts/evaluate-local-moe.js",
    "qa:plugin-guards": "node scripts/qa-plugin-guards.js",
    "postinstall": "node -e \"try { require('sharp') } catch (e) { process.exit(1); }\" || yarn add --ignore-engines sharp@0.34.5"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "audio-decode": "^2.2.2",
    "axios": "^1.3.3",
    "baileys": "git+https://lyfe00011-admin@bitbucket.org/lyfe00011/baileys.git",
    "bgutils-js": "^3.2.0",
    "browser-id3-writer": "^4.4.0",
    "cheerio": "^1.0.0-rc.10",
    "cookie": "^0.5.0",
    "cron": "^3.1.7",
    "dotenv": "^16.4.5",
    "fastq": "^1.19.1",
    "file-type": "^18.2.1",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.0",
    "google-tts-api": "^2.0.2",
    "googleapis": "^126.0.1",
    "googlevideo": "^4.1.1",
    "heroku-client": "^3.1.0",
    "jimp": "^0.16.1",
    "jsdom": "^27.2.0",
    "link-preview-js": "^3.0.4",
    "moment": "^2.29.4",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.1.4",
    "pdfkit": "^0.13.0",
    "pg": "^8.7.3",
    "pino-pretty": "^9.1.1",
    "pm2": "^6.0.14",
    "qrcode-reader": "^1.0.4",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.21.4",
    "sharp": "^0.34.5",
    "simple-git": "^3.16.1",
    "sqlite3": "^5.0.11",
    "translate-google-api": "^1.0.4",
    "youtubei.js": "^17.2.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  }
}
