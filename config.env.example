SESSION_ID="levanter_sessionid"
VPS="true"
AUTO_UPDATE="true"

# Dēmonyx specialist safeguards (optional)
DEMONYX_DX_RATE_LIMIT="30"
DEMONYX_DX_WINDOW_MS="60000"

# Per-user logical sessions (separate from the stable WhatsApp SESSION_ID)
DEMONYX_USER_SESSION_TTL_MS="86400000"
DEMONYX_USER_SESSION_MAX_AGE_MS="2592000000"
DEMONYX_USER_SESSION_MAX="10000"
DEMONYX_USER_SESSION_FILE="data/user-sessions.json"
